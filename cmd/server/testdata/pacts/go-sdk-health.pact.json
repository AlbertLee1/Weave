{
  "consumer": {"name": "weave-go-sdk"},
  "provider": {"name": "weave-server"},
  "metadata": {
    "pactSpecification": "weave-pact-1",
    "documents": "Go SDK probes /health and /health/ready on client construction so a misconfigured WEAVE_BASE_URL surfaces as a typed error before the first business call. Body matchers reflect the per-deployment status string + the per-dependency check map."
  },
  "interactions": [
    {
      "description": "GET /health returns liveness payload",
      "request": {
        "method": "GET",
        "path": "/health"
      },
      "response": {
        "status": 200,
        "headers": {"Content-Type": "application/json"},
        "body": {"status": "alive"}
      }
    },
    {
      "description": "GET /health/ready returns readiness payload",
      "request": {
        "method": "GET",
        "path": "/health/ready"
      },
      "response": {
        "status": 200,
        "body": {
          "status": "ready",
          "checks": {}
        },
        "matchers": {
          "$.status": {"match": "type", "value": "string"},
          "$.checks": {"match": "type", "value": "object"}
        }
      }
    }
  ]
}
