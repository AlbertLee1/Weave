{
  "uid": "weave-slo",
  "title": "Weave SLO / SLI",
  "description": "Service-level dashboard for the Weave Ontology engine. Panels surface the four PRD-mandated signals: HTTP p99 latency, HTTP error rate, edit-batch processing lag (NATS consume duration), and NATS consumer backlog. All queries use metrics exported at /metrics.",
  "tags": ["weave", "slo", "sli"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d"]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "hide": 0,
        "refresh": 1,
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "prometheus"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "expr": "changes(weave_build_info[1m]) > 0",
        "titleFormat": "Weave deploy",
        "textFormat": "{{version}} / {{commit}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "http_p99 — HTTP request latency (p99)",
      "description": "99th-percentile HTTP request latency over a 5-minute rolling window. Derived from the weave_http_request_duration_seconds histogram. SLO target: p99 < 500ms.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(weave_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 (all routes)"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(weave_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 (all routes)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.25},
              {"color": "red", "value": 0.5}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "error_rate — HTTP error ratio (5xx + 4xx)",
      "description": "Fraction of HTTP responses that returned a 5xx or 4xx status over a 5-minute window. Derived from weave_http_requests_total. SLO target: < 1% 5xx, < 5% 4xx.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(weave_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(weave_http_requests_total[5m])), 1)",
          "legendFormat": "5xx error rate"
        },
        {
          "refId": "B",
          "expr": "sum(rate(weave_http_requests_total{status=~\"4..\"}[5m])) / clamp_min(sum(rate(weave_http_requests_total[5m])), 1)",
          "legendFormat": "4xx error rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.01},
              {"color": "red", "value": 0.05}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "edit_batch_lag — NATS edit-batch processing time (p95)",
      "description": "Time the funnel consumer spends processing a single EditBatch message, measured by weave_nats_consume_duration_seconds. High values mean Bleve indexing is falling behind the write path. SLO target: p95 < 1s.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, subject) (rate(weave_nats_consume_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 — {{subject}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, subject) (rate(weave_nats_consume_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 — {{subject}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "nats_consumer_lag — publish vs consume throughput delta",
      "description": "Positive values indicate the consumer is falling behind the publisher. Computed as rate(weave_nats_publish_total) minus rate(weave_nats_consume_total{status=\"ok\"}). Steady-state should hover near zero; sustained positive lag means the JetStream consumer queue is growing.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (subject) (rate(weave_nats_publish_total{status=\"ok\"}[5m])) - sum by (subject) (rate(weave_nats_consume_total{status=\"ok\"}[5m]))",
          "legendFormat": "lag — {{subject}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(weave_nats_consume_total{status=\"error\"}[5m]))",
          "legendFormat": "consume error rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 10}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Build info",
      "description": "Current running build metadata, emitted by weave_build_info on boot.",
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "refId": "A",
          "expr": "weave_build_info",
          "legendFormat": "{{version}} / {{commit}} / {{go_version}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      }
    }
  ]
}
